# Keep hashed text artifacts byte-stable across operating systems.
.gitattributes text eol=lf
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf

.gitignore text eol=lf
LICENSE text eol=lf
VERSION text eol=lf
