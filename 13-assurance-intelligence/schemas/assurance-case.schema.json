{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bridge-Node-7/ai-cyber-assurance/13-assurance-intelligence/schemas/assurance-case.schema.json",
  "title": "AI Cyber Assurance Case",
  "description": "Machine-readable envelope for one bounded assurance decision. Structural validity does not establish factual truth, control effectiveness, certification, compliance, or operational authorization.",
  "type": "object",
  "required": [
    "case_version",
    "case",
    "identities",
    "claims",
    "risks",
    "controls",
    "evidence",
    "findings",
    "decisions",
    "corrective_actions",
    "retests",
    "review_history"
  ],
  "properties": {
    "case_version": {
      "const": "0.2"
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "scope",
        "decision_question",
        "review_path",
        "public_synthetic",
        "reviewed_at",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "decision_question": {
          "type": "string",
          "minLength": 1
        },
        "review_path": {
          "enum": [
            "Quick Review",
            "Full Assurance Lifecycle"
          ]
        },
        "public_synthetic": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "expires_at": {
          "type": "string",
          "format": "date"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ]
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence_class",
          "source",
          "owner",
          "collected_at",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "Observed",
              "Tested",
              "Reported",
              "Inferred",
              "Unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "collected_at": {
            "type": "string",
            "format": "date"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "status"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "disposition"
        ]
      }
    },
    "corrective_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding_ref",
          "decision_ref",
          "owner",
          "status"
        ]
      }
    },
    "retests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding_ref",
          "corrective_action_ref",
          "tester",
          "method",
          "result",
          "independent",
          "tested_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "finding_ref": {
            "type": "string",
            "minLength": 1
          },
          "corrective_action_ref": {
            "type": "string",
            "minLength": 1
          },
          "tester": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "independent": {
            "type": "boolean"
          },
          "tested_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "actor",
          "summary"
        ]
      }
    }
  },
  "additionalProperties": true
}
